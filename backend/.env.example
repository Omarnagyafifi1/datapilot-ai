# =============================================================================
# DataPilot AI - Backend Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values.
# Settings here override the root .env for backend-specific config.
# =============================================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATA_SOURCES_DB_URL=sqlite:///./data_sources.db
QUERY_HISTORY_DB_URL=sqlite:///./query_history.db

# PostgreSQL (uncomment to use instead of SQLite)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=datapilot
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=datapilot

# --- Encryption ---
ENCRYPTION_KEY=changeme-change-me-change-me-change-me

# --- LLM Provider ---
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- LangSmith ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=datapilot-ai

# --- App ---
APP_NAME=DataPilot AI
DEBUG=true
ALLOW_ORIGINS=*
