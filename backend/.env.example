# Development environment variables for datapilot-ai backend
# Copy to `.env` and fill secrets for local development.
# For production, set these as Azure Container App environment variables
# (or inject via Azure Key Vault).

# ═══════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════
# For production (PostgreSQL):
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/datapilot
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATA_SOURCES_DB_URL=sqlite+aiosqlite:///./data_sources.db
QUERY_HISTORY_DB_URL=sqlite+aiosqlite:///./query_history.db

# ═══════════════════════════════════════════════
# Azure Blob Storage (required for production)
# ═══════════════════════════════════════════════
# Leave empty to use local filesystem (development).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=datasets

# ═══════════════════════════════════════════════
# Azure Application Insights (optional)
# ═══════════════════════════════════════════════
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ═══════════════════════════════════════════════
# Redis (optional - for distributed rate limiting)
# ═══════════════════════════════════════════════
REDIS_URL=

# ═══════════════════════════════════════════════
# App settings
# ═══════════════════════════════════════════════
APP_NAME=datapilot-ai
DEBUG=true

# ═══════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════
ENCRYPTION_KEY=changeme-change-me-32bytes-min
MAX_UPLOAD_SIZE=52428800

# ═══════════════════════════════════════════════
# LLM Provider (set one)
# ═══════════════════════════════════════════════
LLM_PROVIDER=groq
# Azure OpenAI (AI Foundry)
# AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# LLM provider API keys (placeholders)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ═══════════════════════════════════════════════
# LangSmith Tracing & Evaluation (optional)
# ═══════════════════════════════════════════════
# Get your API key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=datapilot-ai

# ═══════════════════════════════════════════════
# Deployment
# ═══════════════════════════════════════════════
HOST=0.0.0.0
PORT=8000
# Frontend URL for CORS (production)
FRONTEND_URL=
# CORS allowed origins (comma-separated) - default allows all origins for dev
ALLOW_ORIGINS=*
