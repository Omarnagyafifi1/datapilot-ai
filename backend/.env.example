# Development environment variables for datapilot-ai backend
# Copy to `.env` and fill secrets for local development.

# Database (async SQLAlchemy URL). Default uses a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATA_SOURCES_DB_URL=sqlite+aiosqlite:///./data_sources.db
QUERY_HISTORY_DB_URL=sqlite+aiosqlite:///./query_history.db

# App settings
APP_NAME=datapilot-ai
DEBUG=true

# Encryption / secrets (replace with secure values in production)
ENCRYPTION_KEY=changeme-change-me-32bytes-min

# LLM provider API keys (placeholders)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: override backend host/port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated) - default allows all origins for dev
ALLOW_ORIGINS=*
