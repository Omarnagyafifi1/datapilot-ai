# =============================================================================
# DataPilot AI - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the appropriate values for your environment.
# Do NOT commit `.env` files with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development, production, staging
# Controls logging level, CORS behavior, and storage backend
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Main application database (async SQLAlchemy URL)
# For development: SQLite (recommended for local testing)
# For production: PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Data sources registry database (tracks all connected data sources)
DATA_SOURCES_DB_URL=sqlite:///./data_sources.db

# Query history database (stores query logs and analytics)
QUERY_HISTORY_DB_URL=sqlite:///./query_history.db

# LangGraph memory backend for conversation checkpointing
# For development: leave empty for in-memory checkpointing
# For production: Use PostgreSQL connection string
LANGGRAPH_MEMORY_DB_URI=

# Run LangGraph PostgreSQL migrations on startup (for production)
LANGGRAPH_RUN_MIGRATIONS_ON_START=false

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Options: local, azure
# Production deployments should use Azure Blob Storage
STORAGE_TYPE=local

# Upload directory (local path when STORAGE_TYPE=local)
UPLOAD_DIR=./uploads

# Azure Storage settings (required when STORAGE_TYPE=azure)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER_NAME=

# -----------------------------------------------------------------------------
# FRONTEND & CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Frontend URL for CORS (comma-separated for multiple origins)
# In development, wildcard "*" is acceptable
# In production, specify your actual domain(s)
FRONTEND_URL=http://localhost:5173
ALLOW_ORIGINS=*

# -----------------------------------------------------------------------------
# LLM PROVIDER API KEYS
# -----------------------------------------------------------------------------
# Multiple LLM providers are supported; configure one or more
# At least one provider with a valid key is required for query generation

# OpenAI (for GPT models)
OPENAI_API_KEY=

# Groq (for Llama, Mixtral models)
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter (unified API for multiple models)
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Together.ai
TOGETHER_API_KEY=

# Default LLM provider (used when no provider is specified)
DEFAULT_LLM_PROVIDER=groq

# Default model for the provider (used when no model is specified)
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# LANGSMITH TRACING & EVALUATION
# -----------------------------------------------------------------------------
# Enable LangChain tracing for observability
LANGCHAIN_TRACING_V2=false

# LangSmith API key (get from https://smith.langchain.com)
LANGCHAIN_API_KEY=

# LangSmith project name
LANGCHAIN_PROJECT=datapilot-ai

# LangSmith endpoint
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
# Fernet encryption key for securing database credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Query approval TTL in seconds (time before approval expires)
APPROVAL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
# Maximum file size in megabytes
MAX_UPLOAD_SIZE_MB=100

# Allowed file extensions (comma-separated, with leading dot)
ALLOWED_FILE_EXTENSIONS=.csv,.db,.sqlite,.sqlite3,.xlsx,.json