# =============================================================================
# DataPilot AI - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Database ---
# Default: SQLite (local development)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATA_SOURCES_DB_URL=sqlite:///./data_sources.db
QUERY_HISTORY_DB_URL=sqlite:///./query_history.db

# For production, use PostgreSQL (set POSTGRES_* vars to auto-switch)
# POSTGRES_HOST=your-postgres-server.postgres.database.azure.com
# POSTGRES_PORT=5432
# POSTGRES_USER=datapilot
# POSTGRES_PASSWORD=your-password
# POSTGRES_DB=datapilot

# --- Encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-change-me-change-me-change-me

# --- LLM Provider ---
# Options: groq | openrouter | gemini | azure | mock | litellm
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Azure OpenAI (AI Foundry or direct Azure OpenAI)
# For AI Foundry (Entra ID auth - leave AZURE_OPENAI_API_KEY empty):
# AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
#
# For direct Azure OpenAI (API key auth):
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- LangSmith (optional - for tracing & evaluation) ---
# https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=datapilot-ai

# --- App Settings ---
APP_NAME=DataPilot AI
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated allowed origins. Use * for development.
ALLOW_ORIGINS=*

# --- Redis (optional - for approval queue) ---
REDIS_URL=redis://localhost:6379/0

# --- LangGraph Memory (optional - PostgreSQL for persistent memory) ---
LANGGRAPH_MEMORY_DB_URI=
LANGGRAPH_RUN_MIGRATIONS_ON_START=false

# --- Application Insights (Azure) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
