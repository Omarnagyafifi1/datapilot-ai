# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATA_SOURCES_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
ENCRYPTION_KEY=your_fernet_key_here

# LangGraph Memory (short-term + long-term)
LANGGRAPH_MEMORY_DB_URI=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
LANGGRAPH_RUN_MIGRATIONS_ON_START=false

# LLM API Keys
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# App Settings
APP_NAME="DataPilot AI"
DEBUG=True
